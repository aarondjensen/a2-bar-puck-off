rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // A final score: whole numbers, no tie, the winner at 21 or more.
    function validScore(d) {
      return d.keys().hasOnly(['a', 'b', 'scoreA', 'scoreB', 'by', 'at', 'edited'])
        && d.a is string && d.b is string && d.a != d.b && d.by is string
        && d.scoreA is int && d.scoreB is int
        && d.scoreA >= 0 && d.scoreB >= 0 && d.scoreA <= 99 && d.scoreB <= 99
        && d.scoreA != d.scoreB
        && (d.scoreA >= 21 || d.scoreB >= 21);
    }

    // Everybody reads. Any league member (or admin) may post a score for a match that has none
    // yet, under their own uid, and nobody but an admin may change or remove one
    // once it is there.
    match /results/{matchId} {
      allow read: if true;
      allow create: if (isMember() || isAdmin())
        && validScore(request.resource.data)
        && request.resource.data.by == request.auth.uid
        && matchId.matches('^(s[1-5]-m[1-6]|p-(W[1-5]|L[1-4]|F[12]))$');
      allow update: if isAdmin() && validScore(request.resource.data);
      allow delete: if isAdmin();
    }

    // Team names, players, the five regular-season dates and the playoff dates. Everybody reads; only an admin writes, and
    // only the one document, in the shape the app saves. Team ids and matchups are not
    // stored here: they are fixed in the app so scores stay attached to the right teams.
    match /config/league {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['teams', 'dates', 'playoffs', 'by', 'at'])
        && request.resource.data.teams is list && request.resource.data.teams.size() == 6
        && request.resource.data.dates is list && request.resource.data.dates.size() == 5
        && request.resource.data.playoffs is list
        && request.resource.data.playoffs.size() >= 1 && request.resource.data.playoffs.size() <= 6;
    }

    // Finalized weeks. The director finalizes a week once all its scores are in; the
    // standings count only finalized weeks. Everybody reads; only an admin writes.
    match /weeks/{wk} {
      allow read: if true;
      allow create, update: if isAdmin() && wk.matches('^s[1-5]$')
        && request.resource.data.keys().hasOnly(['n', 'by', 'at'])
        && request.resource.data.n is int;
      allow delete: if isAdmin();
    }

    // League membership. A signed-in user joins by writing their own document with the
    // league code; the rule compares it with secret/league, which only an admin can read
    // or write (rules can read it even though clients can't). Members are never edited; an admin can delete one.
    match /members/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'email', 'at'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.code is string
        && request.resource.data.code == get(/databases/$(database)/documents/secret/league).data.code;
      allow delete: if isAdmin();
    }
    match /secret/league {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string && request.resource.data.code.size() > 0;
    }

    // The admin's own membership document. Created by hand in the console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
